# ===== 大模型（任何 OpenAI 兼容接口都可以）=====
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=在这里填你的 key

# ===== 模拟电商中台服务 =====
COMMERCE_API_BASE_URL=http://127.0.0.1:18081

# ===== 数据库 =====
# 默认 SQLite，零安装；要切 MySQL 改下面这行并注释掉上面那行
DATABASE_URL=sqlite+aiosqlite:///./customer_service.db
# DATABASE_URL=mysql+aiomysql://root:你的密码@127.0.0.1:3306/customer_service?charset=utf8mb4

# ===== 服务监听 =====
APP_HOST=127.0.0.1
APP_PORT=18082

# ===== 可选调优 =====
# 会话空闲多久开启新会话（秒）
SESSION_TIMEOUT_SECONDS=3600
# 单轮最多推进多少个 flow step
MAX_FLOW_STEPS=1000
# 提示词里带多少轮历史
HISTORY_TURNS=10
# 演示用户 ID（商品推荐等场景使用）
DEMO_USER_ID=u1001
